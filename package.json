{
  "name": "seller-image-price-helper",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"node server/index.js\"",
    "dev:client": "vite",
    "dev:server": "node server/index.js",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "start": "node server/index.js",
    "cap:sync": "npm run build && cap sync android",
    "cap:open": "cap open android",
    "cap:run": "cap run android",
    "cap:build:apk": "npm run build && cap sync android && cd android && ./gradlew assembleDebug",
    "cap:build:release": "npm run build && cap sync android && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "express": "latest",
    "react": "latest",
    "react-dom": "latest",
    "tailwindcss": "latest",
    "vite": "latest",
    "dotenv": "latest",
    "@capacitor/core": "latest"
  },
  "devDependencies": {
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "@eslint/js": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "@capacitor/cli": "latest",
    "@capacitor/android": "latest"
  }
}
